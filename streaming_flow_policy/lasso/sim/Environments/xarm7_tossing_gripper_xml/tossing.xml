<mujoco model="single_xarm7">
  <compiler angle="radian" autolimits="true" meshdir="assets"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>

  <visual>
    <rgba fog="1 1 1 1"/>
    <global offwidth="1920" offheight="1080"/>
  </visual>


  <asset>
    <!-- 导入STL网格 -->
    <!-- <mesh name="ring_mesh" file="hollow_ring.stl" scale="0.001 0.001 0.001"/> -->
    <!-- <mesh name="worktable_mesh" file="table_user.stl" scale="0.001 0.001 0.001"/> -->

    <!-- 材质定义 -->
    <material name="ring_material" rgba="0.89 0.59 0.22 1" specular="0.5"/>

    <texture name="grid" type="2d" builtin="flat" rgb1="1 1 1" rgb2="1 1 1" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance=".2"/>

    <material name="red" rgba="0.8 0.2 0.2 1"/>
    <material name="orange" rgba="0.8 0.5 0.2 1"/>
    <material name="yellow" rgba="0.8 0.8 0.2 1"/>
    <material name="green" rgba="0.2 0.8 0.2 1"/>
    <material name="blue" rgba="0.2 0.2 0.8 1"/>
    <material name="purple" rgba="0.6 0.2 0.8 1"/>
    <material name="white" rgba="1 1 1 1"/>
    <material name="gray" rgba="0.753 0.753 0.753 1"/>
    <material name="black" rgba="0.149 0.149 0.149 1"/>
    <material name="plastic" rgba="0.9 0.9 0.9 1"/>

    <!-- XArm-7 meshes -->
    <mesh file="link_base.stl"/>
    <mesh file="link1.stl"/>
    <mesh file="link2.stl"/>
    <mesh file="link3.stl"/>
    <mesh file="link4.stl"/>
    <mesh file="link5.stl"/>
    <mesh file="link6.stl"/>
    <mesh file="link7.stl"/>
    <mesh file="end_tool.stl"/>

    <!-- Robotiq 2F85 official meshes -->
    <mesh class="2f85" file="base_mount.stl"/>
    <mesh class="2f85" file="base.stl"/>
    <mesh class="2f85" file="driver.stl"/>
    <mesh class="2f85" file="coupler.stl"/>
    <mesh class="2f85" file="follower.stl"/>
    <mesh class="2f85" file="pad.stl"/>
    <mesh class="2f85" file="silicone_pad.stl"/>
    <mesh class="2f85" file="spring_link.stl"/>
  </asset>

  <default>
    <default class="xarm7">
      <geom type="mesh" material="white"/>
      <joint axis="0 0 1" armature="0.1" range="-6.28319 6.28319" frictionloss="1"/>
      <general biastype="affine" ctrlrange="-6.28319 6.28319"/>
      <default class="size1">
        <joint damping="10"/>
        <general gainprm="1500" biasprm="0 -1500 -150" forcerange="-50 50"/>
      </default>
      <default class="size2">
        <joint damping="5"/>
        <general gainprm="1000" biasprm="0 -1000 -100" forcerange="-30 30"/>
      </default>
      <default class="size3">
        <joint damping="2"/>
        <general gainprm="800" biasprm="0 -800 -80" forcerange="-20 20"/>
      </default>
      <!-- XArm wrist site -->
      <site size="0.001" rgba="1 0 0 1" group="4"/>
    </default>

    <!-- 2F85 defaults (imported) -->
    <default class="2f85">
      <mesh scale="0.001 0.001 0.001"/>
      <general biastype="affine"/>
      <joint axis="1 0 0"/>
      <default class="driver">
        <joint range="0 0.8" armature="0.005" damping="0.1" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="follower">
        <joint range="-0.872664 0.872664" armature="0.001" pos="0 -0.018 0.0065" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="spring_link">
        <joint range="-0.29670597283 0.8" armature="0.001" stiffness="0.05" springref="2.62" damping="0.00125"/>
      </default>
      <default class="coupler">
        <joint range="-1.57 0" armature="0.001" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3"/>
        <default class="pad_box1">
          <geom mass="0" type="box" pos="0 -0.0026 0.028125" size="0.011 0.004 0.009375" friction="0.7" solimp="0.95 0.99 0.001" solref="0.004 1" priority="1" rgba="0.55 0.55 0.55 1"/>
        </default>
        <default class="pad_box2">
          <geom mass="0" type="box" pos="0 -0.0026 0.009375" size="0.011 0.004 0.009375" friction="0.6" solimp="0.95 0.99 0.001" solref="0.004 1" priority="1" rgba="0.45 0.45 0.45 1"/>
        </default>
      </default>
    </default>
  </default>

  <worldbody>
    <!-- 光源 -->
    <light diffuse=".8 .8 .8" pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <!-- <light diffuse=".5 .5 .5" pos="0 0 3.0" dir="0 0 -1"/> -->
    <!-- <light diffuse=".3 .3 .3" pos="2 2 3.0" dir="-1 -1 -1"/> -->

    <!-- 地板 -->
    <geom name="floor" size="0 0 0.125" type="plane" material="grid"/>

    <!-- 工作桌面 -->
    <body name="work_table" pos="0 0 0">
      <geom name="work_table_geom" type="box" size="0.800 0.420 0.02" pos="0.00 0.34 0.396" rgba="0.545098 0.360784 0.219608 1" material="plastic" />

      <!-- <geom name="work_table_geom1" type="box" size="0.220 0.400 0.02" pos="-0.390 0.30 0.396" rgba="0.545098 0.360784 0.219608 1" material="plastic" />
      <geom name="work_table_geom2" type="box" size="0.220 0.400 0.02" pos=" 0.390 0.30 0.396" rgba="0.545098 0.360784 0.219608 1" material="plastic" />
      <geom name="work_table_geom3" type="box" size="0.200 0.200 0.02" pos= "0.000 0.50 0.396" rgba="0.545098 0.360784 0.219608 1" material="plastic" />
      <geom name="work_table_geom4" type="box" size="0.200 0.100 0.02" pos= "0.000 0.00 0.396" rgba="0.545098 0.360784 0.219608 1" material="plastic" /> -->
    </body>

    <!-- Left XArm-7 (底座中心点在0.0, 0, 0.42, 朝向前方桌子) -->
