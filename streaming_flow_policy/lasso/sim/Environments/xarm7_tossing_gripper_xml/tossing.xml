                <joint name="left_joint5" class="size2"/>
                <geom mesh="link5"/>
                <body name="left_link6" quat="1 1 0 0">
                  <inertial pos="0.06469 0.03278 0.02141" quat="-0.217672 0.772419 0.16258 0.574069" mass="1.325"
                    diaginertia="0.00245421 0.00221646 0.00107273"/>
                  <joint name="left_joint6" range="-1.69297 3.14159" class="size3"/>
                  <geom mesh="link6"/>
                  <body name="left_link7" pos="0.076 0.097 0" quat="1 -1 0 0">
                    <inertial pos="0 -0.00677 -0.01098" quat="0.487612 0.512088 -0.512088 0.487612" mass="0.17"
                      diaginertia="0.000132176 9.3e-05 5.85236e-05"/>
                    <joint name="left_joint7" range="-6.28319 6.28319" class="size3"/>
                    <geom material="gray" mesh="end_tool"/>

                    <!-- 这是末端执行器的定义 -->
                    <body name="left_end_effector" pos="0.000 0.000 0.150" euler="0 0 0">
                      <inertial pos="0 0 0" mass="0"/>
                      <geom name="left_end_effector_geom" type="sphere" density="0" size="0.05" contype="0" conaffinity="0" rgba="0.8 0.2 0.2 0.0" group="2"/>
                    </body>


                    <!-- Official 2F85 assembly (Left) -->
                    <body name="left_base_mount" pos="0 0 0" childclass="2f85">
                      <geom class="visual" mesh="base_mount" material="black"/>
                      <geom class="collision" mesh="base_mount"/>
                      <body name="left_gripper_base" pos="0 0 0.0038" quat="0 0 0 1">
                        <inertial mass="0.777441" pos="0 -2.70394e-05 0.0354675" quat="1 -0.00152849 0 0" diaginertia="0.000260285 0.000225381 0.000152708"/>
                        <geom class="visual" mesh="base" material="black"/>
                        <geom class="collision" mesh="base"/>
                        <site name="left_pinch" pos="0 0 0.145" type="sphere" group="5" rgba="0.9 0.9 0.9 1" size="0.005"/>
                        <!-- Right linkage -->
                        <body name="left_right_driver" pos="0 0.0306011 0.054904">
                          <inertial mass="0.00899563" pos="2.96931e-12 0.0177547 0.00107314" quat="0.681301 0.732003 0 0" diaginertia="1.72352e-06 1.60906e-06 3.22006e-07"/>
                          <joint name="left_right_driver_joint" class="driver"/>
                          <geom class="visual" mesh="driver" material="gray"/>
                          <geom class="collision" mesh="driver"/>
                          <body name="left_right_coupler" pos="0 0.0315 -0.0041">
                            <inertial mass="0.0140974" pos="0 0.00301209 0.0232175" quat="0.705636 -0.0455904 0.0455904 0.705636" diaginertia="4.16206e-06 3.52216e-06 8.88131e-07"/>
                            <joint name="left_right_coupler_joint" class="coupler"/>
                            <geom class="visual" mesh="coupler" material="black"/>
                            <geom class="collision" mesh="coupler"/>
                          </body>
                        </body>
                        <body name="left_right_spring_link" pos="0 0.0132 0.0609">
                          <inertial mass="0.0221642" pos="-8.65005e-09 0.0181624 0.0212658" quat="0.663403 -0.244737 0.244737 0.663403" diaginertia="8.96853e-06 6.71733e-06 2.63931e-06"/>
                          <joint name="left_right_spring_link_joint" class="spring_link"/>
                          <geom class="visual" mesh="spring_link" material="black"/>
                          <geom class="collision" mesh="spring_link"/>
                          <body name="left_right_follower" pos="0 0.055 0.0375">
                            <inertial mass="0.0125222" pos="0 -0.011046 0.0124786" quat="1 0.1664 0 0" diaginertia="2.67415e-06 2.4559e-06 6.02031e-07"/>
                            <joint name="left_right_follower_joint" class="follower"/>
                            <geom class="visual" mesh="follower" material="black"/>
                            <geom class="collision" mesh="follower"/>
                            <body name="left_right_pad" pos="0 -0.0189 0.01352">
                              <geom class="pad_box1" name="left_right_pad1"/>
                              <geom class="pad_box2" name="left_right_pad2"/>
                              <inertial mass="0.0035" pos="0 -0.0025 0.0185" quat="0.707107 0 0 0.707107" diaginertia="4.73958e-07 3.64583e-07 1.23958e-07"/>
                              <geom class="visual" mesh="pad"/>
                              <body name="left_right_silicone_pad">
                                <geom class="visual" mesh="silicone_pad" material="black"/>
                              </body>
                            </body>
                          </body>
                        </body>
                        <!-- Left linkage -->
                        <body name="left_left_driver" pos="0 -0.0306011 0.054904" quat="0 0 0 1">
                          <inertial mass="0.00899563" pos="0 0.0177547 0.00107314" quat="0.681301 0.732003 0 0" diaginertia="1.72352e-06 1.60906e-06 3.22006e-07"/>
