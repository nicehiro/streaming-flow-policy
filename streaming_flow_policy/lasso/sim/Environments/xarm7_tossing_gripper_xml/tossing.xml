                            <geom class="collision" mesh="follower"/>
                            <body name="left_left_pad" pos="0 -0.0189 0.01352">
                              <geom class="pad_box1" name="left_left_pad1"/>
                              <geom class="pad_box2" name="left_left_pad2"/>
                              <inertial mass="0.0035" pos="0 -0.0025 0.0185" quat="1 0 0 1" diaginertia="4.73958e-07 3.64583e-07 1.23958e-07"/>
