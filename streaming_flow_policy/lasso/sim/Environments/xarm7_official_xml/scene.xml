<mujoco model="xarm7 scene">
  <!-- 加载不带夹爪的xArm7模型 -->
  <include file="xarm7_nohand.xml"/>
  
  <!-- 未知 -->
  <statistic center="0.2 0 0.4" extent=".65"/>

  <!-- 视觉效果定义 -->
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-20"/>
  </visual>

  <asset>
    <!-- 天空盒样式 -->
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    
    <!-- 地板样式1 -->
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    
    <!-- 地板样式2 -->
    <texture type="2d" name="grid" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance=".2"/>

    <!-- 多种颜色RGB定义 -->
    <material name="red" rgba="0.8 0.2 0.2 1"/>
    <material name="orange" rgba="0.8 0.5 0.2 1"/>
    <material name="yellow" rgba="0.8 0.8 0.2 1"/>
    <material name="green" rgba="0.2 0.8 0.2 1"/>
    <material name="blue" rgba="0.2 0.2 0.8 1"/>
    <material name="purple" rgba="0.6 0.2 0.8 1"/>
    <material name="black" rgba="0.149 0.149 0.149 1"/>
    <material name="plastic" rgba="0.9 0.9 0.9 1"/>
  </asset>

  <!-- 灯光及地板定义 -->
  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05"  type="plane" material="groundplane"/>
    <!-- <geom name="floor" size="0 0 0.125" type="plane" material="grid"/> -->
  </worldbody>

  <!-- 相机定义 -->
  <worldbody>
    <body name="camera1" pos=" 0.5  0.0 1.2" euler="0.0 0.0 0.0">
      <camera name="cam1" fovy="60"/>
    </body>
    
    <body name="camera2" pos=" 0.0  0.5 1.2" euler="0.0 0.0 0.0">
      <camera name="cam2" fovy="60"/>
    </body>  

    <body name="camera3" pos="-0.5  0.0 1.2" euler="0.0 0.0 0.0">
      <camera name="cam3" fovy="60"/>
    </body>  

    <body name="camera4" pos=" 0.0 -0.5 1.2" euler="0.0 0.0 0.0">
      <camera name="cam4" fovy="60"/>
    </body>  
  </worldbody>

</mujoco>
